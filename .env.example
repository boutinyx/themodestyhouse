# Copy to .env.local for local dev, and set the same keys in the Railway
# service variables for production. Never commit real values.

# --- Contact form email (Resend) -------------------------------------------
# Outbound only. Inbound mail to hello@ still arrives via Cloudflare Email
# Routing — the two are unrelated.
#
# Chosen over Cloudflare Email Sending because that requires the Workers Paid
# plan ($5/mo); Resend's free tier is 3,000/month and 100/day on one domain.
#
# Without all three, /api/contact returns 503 and logs why. It never pretends a
# message was delivered.
RESEND_API_KEY=
# Where contact form messages land — your real inbox, via Email Routing.
CONTACT_TO_EMAIL=hello@themodestyhouse.com
# The From: address. Must be on the domain verified in Resend.
#
# USE A SUBDOMAIN. A domain may have only ONE SPF record; the apex already has
# Cloudflare's (v=spf1 include:_spf.mx.cloudflare.net ~all). Verifying the apex
# in Resend would mean merging both includes into that one record, and two SPF
# records is a permanent error that breaks all authentication. Verifying
# send.themodestyhouse.com keeps the two entirely separate.
CONTACT_FROM_EMAIL=noreply@send.themodestyhouse.com

# --- Spam protection (Cloudflare Turnstile) --------------------------------
# The SITE key is public — it identifies the widget in the page and is meant to
# be visible. The SECRET key must never be prefixed NEXT_PUBLIC_.
#
# NOTE: NEXT_PUBLIC_* is inlined at BUILD time. Setting it in Railway after a
# deploy does nothing until the next build.
#
# If TURNSTILE_SECRET_KEY is unset the form still works (honeypot, validation
# and rate limiting still apply) but logs a warning that spam protection is off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Affiliate -------------------------------------------------------------
# Also inlined at build time; a fresh deploy is required after setting it.
NEXT_PUBLIC_SKIMLINKS_ID=

# --- Staff admin (/staff/curate) --------------------------------------------
# Without BOTH set, /api/staff/login always rejects — there is no default
# password. Generate real random values for production, e.g.:
#   openssl rand -base64 24
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Ghost (headless CMS for /editorial). GHOST_URL is the public origin; the build calls it
# because Railway private networking is unavailable during the build phase.
GHOST_URL=https://cms.themodestyhouse.com
GHOST_CONTENT_KEY=
# Different value per service (production and staging each register their own webhook).
GHOST_WEBHOOK_SECRET=
# Runtime only. Falls back to GHOST_URL when unset.
GHOST_INTERNAL_URL=http://ghost.railway.internal:2368
# Production ONLY. Purges the changed URLs at Cloudflare after a publish. Staging must not set these.
CLOUDFLARE_ZONE_ID=
