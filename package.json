{
  "name": "modest-house",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.9.0 || ^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "predev": "node -e \"require('fs').writeFileSync('data/.local-only','Layer-4 sentinel for lib/devOnly.ts. Gitignored on purpose: its absence is what disables /admin/curate in a deployment.\\n')\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "verify:gate": "node scripts/verify-gate.mjs",
    "scrape": "tsx scripts/scrape.mjs",
    "build:data": "tsx scripts/build-data.mjs",
    "refresh": "tsx scripts/refresh.mjs",
    "refresh:summary": "tsx --no-warnings scripts/refresh-summary.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
