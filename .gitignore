# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which documents the required keys and holds no secrets.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# NOTE: data/raw-products.json is deliberately TRACKED as of 2026-08-05. The
# nightly refresh workflow needs it in CI, and committing it closes P0-B — the
# catalogue no longer exists solely on one laptop. Do not re-ignore it without
# solving both.

# Layer-4 security sentinel (lib/devOnly.ts). Its ABSENCE is what disables the
# local-only curation tooling in a deployment, so this line is load-bearing —
# lib/devOnly.test.ts fails if this path stops being ignored.
data/.local-only

# Pre-refresh snapshots of raw-products.json (scripts/refresh.mjs). Local only;
# git history is now the real backup.
data/.backups/

# --- local-only working dirs (never commit; ~3 GB combined) ---
# CLIP tagger image cache
.cache/
# python venv for scripts/tag_style.py (full torch install)
.venv-style/
# local tooling session transcripts — may contain sensitive context
conversations/

# Generated hero candidates (46 MB, unreferenced). Kept locally, not versioned —
# if one gets chosen, move it into public/ properly and commit that single file.
public/hero-gen/
# Generated image library (44 MB, unreferenced source material). Same rule as
# hero-gen: chosen images get moved into public/ and committed individually.
higgsfield-library/
# Debug dump from scripts/tag_style.py — regenerable
data/archetypes.clip.debug.json

# Local curation review page (throwaway, regenerable). Self-contained ~1.5 MB.
sleeveless-review.html

# Local one-off image picker (throwaway, regenerable)
aab-hero-picker.html

# Playwright mobile/a11y audit output (screenshots + report)
.audit/

# Generated review sheet — rebuild with `node scripts/cutout-sheet.mjs`.
style-cutouts.html

# Working folder for re-cut cutout sources (large masters, kept locally).
public/style-it/png's trans/

# Local worktrees for isolated feature work (superpowers:using-git-worktrees).
.worktrees/

# Runtime cuts made from the live /staff/curate admin (lib/liveCuts.ts). Lives
# on the production container's disk only — deliberately NOT the git-tracked
# decisions.json. scripts/merge-live-cuts.mjs folds it in on purpose, later.
data/.live-cuts.json

# Same reasoning, for garment moves made from the inline staff edit controls
# (lib/liveGarmentOverrides.ts). scripts/merge-live-edits.mjs folds it into
# data/garment-overrides.json on purpose, later.
data/.live-garment-overrides.json

# Same reasoning again, for the two specialty-lane moves (Modest Activewear,
# Layering Basics) not reachable via a garment override
# (lib/liveLaneOverrides.ts). scripts/merge-live-edits.mjs folds it into
# data/lane-overrides.json on purpose, later.
data/.live-lane-overrides.json

# Runtime Everyday/Occasion/Slip assignments made from the live staff pencil
# (lib/liveDressTypes.ts). scripts/merge-live-edits.mjs folds it into
# data/dress-subtypes.json. Added 2026-08-27.
data/.live-dress-types.json

# Generated colour-review page — regenerate with scripts/colour-review.mjs.
# The DECISIONS it produces live in data/colour-overrides.json, which IS tracked.
/colour-review.html

# Contact sheets for the colour review — regenerate with scripts/colour-sheets.mjs.
# The DECISIONS they produce live in data/colour-overrides.json, which IS tracked.
/.colour-sheets/
/.colour-probe/
